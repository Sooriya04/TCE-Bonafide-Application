<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Form Confirmation</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link 
      rel="stylesheet" 
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" 
    />

    <style>
      html,
      body {
        height: 100%;
        margin: 0;
      }

      body {
        background-color: #fffdf5;
        font-family: 'Montserrat', sans-serif;
        display: flex;
        flex-direction: column;
      }

      header {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 10px 30px;
        background-color: #f1f1f1;
      }

      header img {
        width: 300px;
        max-width: 100%;
        height: auto;
      }

      @media screen and (max-width: 768px) {
        header img {
          width: 220px;
        }
      }

      .content-wrapper {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
      }

      .form-card {
        background: white;
        border-radius: 20px;
        max-width: 420px;
        width: 100%;
        padding: 3rem 2rem;
        text-align: center;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        border: none;
      }

      .success-icon {
        font-size: 4rem;
        color: #00a65a;
        margin-bottom: 20px;
        animation: bounceIn 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      }

      @keyframes bounceIn {
        from { opacity: 0; transform: scale(0.3); }
        to { opacity: 1; transform: scale(1); }
      }

      .title {
        color: #800000;
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
      }

      .student-name {
        font-size: 1.25rem;
        font-weight: 600;
        color: #333;
        margin-bottom: 15px;
        display: block;
      }

      .instructions {
        color: #666;
        font-size: 1rem;
        margin-bottom: 2rem;
        line-height: 1.5;
      }

      .btn-action {
        background-color: #800000;
        color: white;
        border: none;
        border-radius: 25px;
        padding: 12px 30px;
        font-size: 1.1rem;
        font-weight: 600;
        width: 100%;
        transition: 0.3s;
        text-decoration: none;
        display: block;
      }

      .btn-action:hover {
        background-color: #660000;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(128, 0, 0, 0.3);
      }
    </style>
  </head>
  <body>
    <header>
      <img src="/images/tce_logo.png" alt="TCE Logo" />
    </header>

    <div class="content-wrapper">
      <div class="card form-card">
        <div class="success-icon">
          <i class="fas fa-check-circle"></i>
        </div>
        <h2 class="title text-uppercase mb-3">Request Confirmed</h2>
        <span class="student-name"><%= name %></span>
        <p class="instructions">
          Your bonafide request has been successfully recorded.<br>
          Please visit the <strong>office room</strong> for further details.
        </p>
        <a href="/logout" class="btn-action">Return to Login</a>
      </div>
    </div>
  </body>
</html>

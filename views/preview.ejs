<html>

<head>
  <title>Preview Bonafide Form</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

  <style>
    header {
      display: flex;
      align-items: center;
      padding: 10px 30px;
      background-color: #f1f1f1;
    }

    header img {
      max-width: 100%;
      height: auto;
      width: 300px;
    }

    @media screen and (max-width: 768px) {
      header {
        justify-content: center;
        padding: 10px 20px;
      }

      header img {
        width: 200px;
      }
    }

    @media screen and (max-width: 480px) {
      header img {
        width: 160px;
      }
    }

    body {
      background-color: #fffdf5;
      font-family: 'Arial', cursive;
    }

    .form-card {
      background-color: white;
      border-radius: 20px;
      max-width: 380px;
      width: 100%;
      padding: 2rem;
      margin: 40px auto;
      box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
    }

    .title {
      color: #800000;
      font-size: 1.8rem;
      text-align: center;
      margin-bottom: 10px;
    }

    .subtitle {
      color: #a05252;
      font-size: 1rem;
      text-align: center;
      margin-bottom: 20px;
    }

    .btn-confirm {
      background-color: #800000;
      color: white;
      border-radius: 20px;
      padding: 10px;
      font-size: 1.1rem;
      border: none;
      width: 100%;
    }

    .btn-confirm:hover {
      background-color: #660000;
      color: white;
    }

    .btn-edit {
      background-color: #800000;
      color: rgb(245, 243, 243);
      border-radius: 20px;
      padding: 10px;
      font-size: 1.1rem;
      width: 100%;
      margin-top: 10px;
    }

    .btn-edit:hover {
      background-color: #660000;
      color: white;
    }

    /* Toast Notification Styles */
    #toast-container {
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 9999;
      pointer-events: none;
    }

    .toast-card {
      background: white;
      border-left: 5px solid #800000;
      color: #333;
      padding: 15px 25px;
      border-radius: 12px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
      margin-bottom: 15px;
      min-width: 280px;
      max-width: 400px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      pointer-events: auto;
      animation: slideIn 0.3s ease forwards, fadeOut 0.3s ease 4.7s forwards;
      font-size: 0.95rem;
      font-weight: 600;
      text-align: left;
    }

    @keyframes slideIn {
      from { transform: translateX(100%); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }

    @keyframes fadeOut {
      from { transform: translateX(0); opacity: 1; }
      to { transform: translateX(100%); opacity: 0; }
    }

    @media (max-width: 576px) {
      .form-card {
        padding: 1.5rem 1rem;
        border-radius: 15px;
        margin-top: 20px;
        width: 95%;
        max-width: none;
      }
      #toast-container {
        right: 10px;
        left: 10px;
        top: 10px;
      }
      .toast-card {
        min-width: auto;
        width: 100%;
      }
    }
  </style>
</head>

<body>
  <!-- Toast Container -->
  <div id="toast-container"></div>
  <header>
    <img src="/images/tce_logo.png" alt="TCE Logo" />
  </header>
  <div class="form-card">
    <h2 class="title">Preview Your Details</h2>
    <p class="subtitle">Please check before confirming</p>

    <div id="previewFields">
      <p>Name: <%= formData.name %>
      </p>
      <p>Roll No: <%= formData.rollno %>
      </p>
      <p>Parent: <%= formData.relation %>
          <%= formData.parentName %>
      </p>
      <p>Year: <%= formData.year %>
      </p>

      <p>Course: <%= formData.course %>
      </p>
      <p>Branch: <%= formData.branch %>
      </p>

      <p>Current Year: <%= formData.cYear %>
      </p>
      <p>Certificate For: <%= formData.certificateFor %>
      </p>
      <% if (formData.scholarshipType && formData.scholarshipType.trim() !=="" ) { %>
        <p>Scholarship Type: <%= formData.scholarshipType %>
        </p>
        <% } %>
          <p>Date: <%= formData.date ? formData.date.split('-').reverse().join('-') : '' %>
          </p>
    </div>

    <form id="confirmForm" action="/bonafide/confirm" method="POST" class="mt-3">
      <button type="submit" id="confirmBtn" class="btn btn-confirm">Confirm</button>
      <a href="/bonafide" class="btn btn-edit">Edit</a>
    </form>
  </div>

  <script>
    const form = document.getElementById('confirmForm');
    const btn = document.getElementById('confirmBtn');

    form.addEventListener('submit', () => {
      btn.disabled = true;
      btn.textContent = 'Confirming...';
    });

    function showToast(message) {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      toast.className = 'toast-card';
      toast.innerHTML = `<span>${message}</span>`;
      container.appendChild(toast);
      setTimeout(() => toast.remove(), 5000);
    }

    // Handle cooldown error message ("pop")
    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      showToast('<%= errorMessage %>');
      // Re-enable button if it was disabled by a previous click
      btn.disabled = false;
      btn.textContent = 'Confirm';
    <% } %>
  </script>
</body>

</html>
# App Config
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Pools
DATABASE_PRIMARY_URL=postgres://tce_user:tce_secure_password@localhost:5434/tce_bonafide
DATABASE_REPLICA_URL=postgres://tce_user:tce_secure_password@localhost:5435/tce_bonafide

# Redis Cache
REDIS_URL=redis://:tce_redis_secure_password@localhost:6379

# Secrets
SESSION_SECRET=a_very_long_secure_random_string_tce_bonafide_session
DEV_SECRET=dev_secret_tce_token

# Admin Auth Settings
ADMIN_EMAIL=admin_mail
# Generated via: bcrypt.hash('admin_password', 12)
ADMIN_PASSWORD_HASH=a_very_long_secure_random_string_tce_bonafide_session

# Email (SMTP Configuration)
SMTP_HOST=smtp.gmail.com
SMTP_USER=test@gmail.com
SMTP_PASS=testpass
MAIL_FROM=no-reply@tce.edu

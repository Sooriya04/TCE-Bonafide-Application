# App Config
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
SECURE_COOKIES=false

# PostgreSQL Database Pools
DATABASE_PRIMARY_URL=
DATABASE_REPLICA_URL=

# Redis Cache
REDIS_URL=

# Docker Database Configuration
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
REDIS_PASSWORD=

# Secrets
SESSION_SECRET=
DEV_SECRET=
DEV_PASSWORD_HASH=

# Backup Retention Policy Configuration
BACKUP_DAILY_RETENTION_DAYS=30
BACKUP_WEEKLY_RETENTION_WEEKS=12

# Admin Auth Settings
ADMIN_EMAIL=
# Generated via: bcrypt.hash('admin_password', 12)
ADMIN_PASSWORD_HASH=

# Email (SMTP Configuration)
SMTP_HOST=smtp.gmail.com
SMTP_USER=test@gmail.com
SMTP_PASS=testpass
MAIL_FROM=no-reply@tce.edu

# Allowed origins and CSP connect-src values for security
ALLOWED_ORIGINS=
CSP_CONNECT_SRC=
STUDENT_SERVICE_PORT=3001
STUDENT_SERVICE_URL=http://localhost:3001

ADMIN_SERVICE_PORT=3002
ADMIN_SERVICE_URL=http://localhost:3002

DEV_SERVICE_PORT=3003
DEV_SERVICE_URL=http://localhost:3003

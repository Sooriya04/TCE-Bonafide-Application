# App Config
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Pools
DATABASE_PRIMARY_URL=
DATABASE_REPLICA_URL=

# Redis Cache
REDIS_URL=
# Secrets
SESSION_SECRET=
DEV_SECRET=

# Admin Auth Settings
ADMIN_EMAIL=
# Generated via: bcrypt.hash('admin_password', 12)
ADMIN_PASSWORD_HASH=

# Email (SMTP Configuration)
SMTP_HOST=smtp.gmail.com
SMTP_USER=test@gmail.com
SMTP_PASS=testpass
MAIL_FROM=no-reply@tce.edu

# Allowed origins and CSP connect-src values for security
ALLOWED_ORIGINS=
CSP_CONNECT_SRC=
STUDENT_SERVICE_PORT=3001
STUDENT_SERVICE_URL=http://localhost:3001

ADMIN_SERVICE_PORT=3002
ADMIN_SERVICE_URL=http://localhost:3002

DEV_SERVICE_PORT=3003
DEV_SERVICE_URL=http://localhost:3003
